# ==========================================
# API Traffic Inspector - Environment Configuration Template
# ==========================================

# Network Host
HOST=127.0.0.1

# Server Ports
PROXY_PORT=8888
WS_PORT=8889
API_PORT=3001

# SQLite Database Storage Path
DB_PATH=./traffic.db

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Web UI Configuration (Vite)
# ==========================================
VITE_HOST=127.0.0.1
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_WS_URL=ws://127.0.0.1:8889
VITE_PROXY_URL=http://127.0.0.1:8888

